{
  "name": "claude-atdd-workflow",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.2.0"
  },
  "scripts": {
    "test": "node --test --test-reporter=dot \"tests/**/*.test.mjs\"",
    "test:verbose": "node --test --test-reporter=spec \"tests/**/*.test.mjs\"",
    "test:hooks": "node --test --test-reporter=dot \"tests/hooks.test.mjs\" \"tests/guard-*.test.mjs\" \"tests/codex-integrate.test.mjs\" \"tests/task-package-script.test.mjs\"",
    "test:install": "node --test --test-reporter=dot \"tests/install*.test.mjs\" \"tests/agents.test.mjs\"",
    "test:adr": "node --test --test-reporter=dot \"tests/*adr*.test.mjs\"",
    "test:metrics": "node --test --test-reporter=dot \"tests/metrics-*.test.mjs\""
  }
}
