{
  "codex-reviewer": {
    "type": "stdio",
    "command": "npx",
    "args": ["--prefer-offline", "-y", "codex-subagent-mcp@0.6.0"],
    "env": {
      "CODEX_SUBAGENT_DEFAULT_MODEL": "gpt-6.1-sol",
      "CODEX_SUBAGENT_ALLOWED_MODELS": "gpt-6.1-sol,gpt-6-astra",
      "CODEX_SUBAGENT_DEFAULT_EFFORT": "high",
      "CODEX_SUBAGENT_MAX_EFFORT": "high",
      "CODEX_SUBAGENT_MAX_SANDBOX": "read-only",
      "CODEX_SUBAGENT_MCP_SERVERS": "none",
      "CODEX_SUBAGENT_PLUGINS": "none",
      "CODEX_SUBAGENT_APPS": "off",
      "CODEX_SUBAGENT_MAX_DELEGATIONS_PER_HOUR": "10",
      "CODEX_SUBAGENT_MAX_BACKGROUND_JOBS": "2"
    }
  },
  "codex-implementer": {
    "type": "stdio",
    "command": "npx",
    "args": ["--prefer-offline", "-y", "codex-subagent-mcp@0.6.0"],
    "env": {
      "CODEX_SUBAGENT_DEFAULT_MODEL": "gpt-6.1-sol",
      "CODEX_SUBAGENT_ALLOWED_MODELS": "gpt-6.1-sol,gpt-6-astra",
      "CODEX_SUBAGENT_DEFAULT_EFFORT": "high",
      "CODEX_SUBAGENT_MAX_EFFORT": "xhigh",
      "CODEX_SUBAGENT_MAX_SANDBOX": "workspace-write",
      "CODEX_SUBAGENT_MCP_SERVERS": "none",
      "CODEX_SUBAGENT_PLUGINS": "none",
      "CODEX_SUBAGENT_APPS": "off",
      "CODEX_SUBAGENT_MAX_DELEGATIONS_PER_HOUR": "6",
      "CODEX_SUBAGENT_MAX_BACKGROUND_JOBS": "2"
    }
  }
}
