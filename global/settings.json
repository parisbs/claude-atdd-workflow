{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeGitInstructions": false,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current:*)",
      "Bash(git branch --list:*)",
      "Bash(git fetch:*)",
      "Bash(git merge-base:*)",
      "Bash(git merge-tree:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git tag --list:*)",
      "Bash(git stash list:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh label list:*)",
      "Bash(gh repo view:*)",
      "mcp__codex-reviewer__codex_doctor",
      "mcp__codex-reviewer__list_codex_models",
      "mcp__codex-reviewer__codex_recommend",
      "mcp__codex-reviewer__codex_job_status",
      "mcp__codex-reviewer__codex_job_result",
      "mcp__codex-reviewer__codex_job_cancel",
      "mcp__codex-implementer__codex_doctor",
      "mcp__codex-implementer__list_codex_models",
      "mcp__codex-implementer__codex_recommend",
      "mcp__codex-implementer__codex_job_status",
      "mcp__codex-implementer__codex_job_result",
      "mcp__codex-implementer__codex_job_cancel"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/guard-git.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking git and deploy safety rules"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/guard-tests.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking the ATDD test oracle"
          }
        ]
      },
      {
        "matcher": "^mcp__codex-(reviewer|implementer)__codex_(delegate|follow_up)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/guard-codex.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking the Codex delegation rules"
          }
        ]
      }
    ]
  }
}
