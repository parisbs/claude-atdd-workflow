{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeGitInstructions": false,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --show-current:*)",
      "Bash(git branch --list:*)",
      "Bash(git fetch:*)",
      "Bash(git merge-base:*)",
      "Bash(git merge-tree:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git tag --list:*)",
      "Bash(git stash list:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh label list:*)",
      "Bash(gh repo view:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/guard-git.mjs\" --skip-merge",
            "timeout": 15,
            "statusMessage": "Checking git and deploy safety rules"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr merge *)",
            "command": "event=; while IFS= read -r line; do event=\"$event$line\n\"; done; event=\"$event$line\"; case \"$event\" in *merge*) printf '%s' \"$event\" | node \"$HOME/.claude/hooks/guard-git.mjs\" --merge-only ;; esac",
            "timeout": 30,
            "onFailure": "block",
            "statusMessage": "Checking the merge conditions"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/guard-tests.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking the ATDD test oracle"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/guard-codex.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking the Codex delegation rules"
          }
        ]
      }
    ]
  },
  "bashOutputMaxChars": 12000
}
