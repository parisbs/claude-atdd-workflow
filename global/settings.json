{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "includeGitInstructions": false,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current *)",
      "Bash(git branch --list *)",
      "Bash(git fetch *)",
      "Bash(git merge-base *)",
      "Bash(git merge-tree *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git tag --list *)",
      "Bash(git stash list *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh label list *)",
      "Bash(gh repo view *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!**/.env.example)",
      "Read(!**/.env.sample)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/guard-git.mjs\" --skip-merge",
            "timeout": 15,
            "statusMessage": "Checking git and deploy safety rules"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr merge *)",
            "command": "event=; while IFS= read -r line; do event=\"$event$line\n\"; done; event=\"$event$line\"; scope=$event; if [ \"${#event}\" -le 16000 ]; then shape=${event%\"${event##*[!'\n']}\"}; case \"$shape\" in '{'*'}') case \"$event\" in *'\"command\":\"'*'\"command\":\"'*) ;; *'\"command\":\"'*'\",\"description\":\"'*) scope=command ;; esac ;; esac; case \"$scope\" in command) case \"$event\" in *'\"command\":\"'*merge*'\",\"description\":\"'*) scope=merge ;; esac ;; esac; fi; case \"$scope\" in *merge*) printf '%s' \"$event\" | node \"$HOME/.claude/hooks/guard-git.mjs\" --merge-only ;; esac",
            "timeout": 30,
            "onFailure": "block",
            "statusMessage": "Checking the merge conditions"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/guard-tests.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking the ATDD test oracle"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/guard-codex.mjs\"",
            "timeout": 15,
            "statusMessage": "Checking the Codex delegation rules"
          }
        ]
      }
    ]
  },
  "bashOutputMaxChars": 12000
}
